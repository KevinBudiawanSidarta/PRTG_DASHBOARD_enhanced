APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bia?sslmode=disable
SUPABASE_JWT_SECRET=change-me
# Development only: when true, API accepts X-Organization-ID instead of JWT.
DEV_AUTH=true

# Collector
PRTG_SERVER=http://192.168.10.22
PRTG_USER=prtgadmin
PRTG_PASS=
# PRTG API also supports passhash; use it only if preferred.
PRTG_PASSHASH=
PRTG_WEBHOOK_SECRET=change-me
PRTG_INSTANCE_ID=
ORGANIZATION_ID=
POLL_INTERVAL_SEC=60
PRTG_TIMEOUT_SEC=20

# Scheduler
PARTITION_MONTHS_AHEAD=2
